# Environments & secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Runtime data
storage/
*.db

# Eval artifacts: dataset binaries are regenerated from the manifest seed.
# Truth/meta/manifest JSONs and the small committed sample set are kept.
evals/dataset/*/cases/**/*.pdf
evals/dataset/*/cases/**/*.png
evals/dataset/*/cases/**/*.jpg
!evals/dataset/*/samples/**
evals/output/
# Per-run eval reports: one file per invocation, so they pile up fast and say
# nothing a reviewer needs. The committed baseline (evals/baseline_metrics.json)
# and the rendered summary (evals/latest_report.md) are the durable record; CI
# uploads the raw runs as build artifacts.
evals/reports/*.json

# OS / editors
.DS_Store
.idea/
.vscode/
