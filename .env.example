# Copy to .env and adjust. NEVER commit .env.
#
# Host-port note for this machine: 5432/6379/8080 are occupied by other projects,
# so compose publishes Postgres on 5433, Redis on 6380, and the API on 8000.

APILOT_ENV=dev
APILOT_LOG_LEVEL=INFO
APILOT_LOG_FORMAT=console            # console | json

APILOT_DATABASE_URL=postgresql+asyncpg://apilot:apilot@localhost:5433/apilot
APILOT_REDIS_URL=redis://localhost:6380/0

APILOT_STORAGE_DIR=./storage/uploads
APILOT_MAX_UPLOAD_BYTES=15728640     # 15 MiB

# Decision gate: clean matches at or under this total auto-approve.
APILOT_AUTO_APPROVE_MAX_TOTAL=2500.00

APILOT_RATE_LIMIT_ENABLED=true
APILOT_RATE_LIMIT_DEFAULT_PER_MIN=120
APILOT_RATE_LIMIT_INGEST_PER_MIN=30

# LLM configuration. auto = live when ANTHROPIC_API_KEY is set, otherwise fake.
APILOT_LLM_MODE=auto                 # auto | live | fake
APILOT_EXTRACTION_MODEL=claude-opus-5
APILOT_MATCHING_MODEL=claude-opus-5

# HMAC key for vendor payment-detail fingerprints (fraud signal F-110).
# Connection pools and timeouts. db_pool_size must cover APILOT_WORKER_MAX_JOBS with
# headroom: each concurrent job may hold a session, and a job that blocks on checkout
# and then times out is dropped by arq rather than retried.
APILOT_DB_POOL_SIZE=10
APILOT_DB_MAX_OVERFLOW=10
APILOT_DB_STATEMENT_TIMEOUT_MS=30000
APILOT_REDIS_SOCKET_TIMEOUT_S=5.0
APILOT_WORKER_MAX_JOBS=8

# Four-eyes control: refuse approvals from the key that uploaded or corrected the
# invoice. Leave off for a single-operator deployment.
APILOT_REQUIRE_SEPARATE_APPROVER=false

# Keys the HMAC over vendor bank details. This literal is published in the repo,
# so it is a development value only — with APILOT_ENV=prod the app refuses to
# start until it is replaced. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it invalidates every existing fingerprint, so set it once, up front.
APILOT_FINGERPRINT_SECRET=change-me-dev-only

# Anthropic API key. Leave blank to run fully offline with the FakeLLM.
ANTHROPIC_API_KEY=
